# Copy this file to .env and fill in your own values.
# .env is in .gitignore. Never commit it.

# --- Discord ---
# BOT_TOKEN
#   Discord Developer Portal -> your application -> Bot -> Reset Token.
#   Enable "Message Content Intent" on the same page, the prefix commands need it.
# DISCORD_SERVER_ID
#   Turn on Developer Mode in Discord, right click the server, "Copy Server ID".
BOT_TOKEN=
DISCORD_SERVER_ID=

# --- Nextcloud tables ---
# This is where the module data comes from. The host is public, no VPN needed.
# TABLES_PASSWORD is an app password, not your login password:
#   cloud.ovgu.de -> Settings -> Security -> App passwords
TABLES_URL=https://cloud.ovgu.de/apps/tables/
TABLES_USERNAME=
TABLES_PASSWORD=

# --- Optional: where the slash commands are registered ---
#   global  (default) every server, but a client can need up to an hour to see a change
#   guild   only the servers the bot is in right now, but they appear at once
# Never both. Discord keeps the two scopes apart and lists both, so a command in
# both would show up twice. OSCAR empties the scope it does not use.
#OSCAR_COMMAND_SCOPE=guild
